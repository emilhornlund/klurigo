        <p
          class="typography body2 alignCenter widthFull colorDefault"
        >
          Drag 'n' drop a file here, or click to select one
        </p>
        <p
          class="typography control alignCenter widthFull colorSubtle"
        >
          PNG, JPG, GIF, TIFF or WEBP - Max 20 MB
        </p>
      </div>
    </div>
  </div>
</div>
`;

exports[`Dropzone > should render a Dropzone with progress bar 1`] = `
<div>
  <div
    class="dropzone"
  >
    <div
      class="base"
      role="presentation"
      tabindex="0"
    >
      <svg
        class="circularProgressBar secondary medium"
        height="100"
        width="100"
      >
        <circle
          class="circleBackground"
          cx="50"
          cy="50"
          fill="transparent"
          r="45"
          stroke-width="10"
        />
        <circle
          class="circleProgress"
          cx="50"
          cy="50"
          fill="transparent"
          r="45"
          stroke-linecap="round"
          stroke-width="10"
          style="stroke-dasharray: 282.7433388230814; stroke-dashoffset: 141.3716694115407;"
        />
        <text
          class="progressText black"
          dominant-baseline="middle"
          text-anchor="middle"
          x="50%"
          y="50%"
        >
          50
          %
        </text>
      </svg>
    </div>
  </div>
</div>
`;
