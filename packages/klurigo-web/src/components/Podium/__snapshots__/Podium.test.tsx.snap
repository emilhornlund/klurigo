            />
            <div
              class="sparkle"
              style="--sparkle-delay: 0.8s; --sparkle-x: 71%; --sparkle-y: 25%;"
            />
            <div
              class="sparkle"
              style="--sparkle-delay: 1s; --sparkle-x: 85%; --sparkle-y: 35%;"
            />
          </div>
        </div>
      </div>
    </div>
    <div
      class="column"
      data-occupied="true"
      data-testid="podium-column"
      style="--position-index: 0;"
    >
      <div
        class="spacer"
