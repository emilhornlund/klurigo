exports[`Podium > should render Podium from a full leaderboard 1`] = `
<div>
  <div
    class="main"
  >
    <div
      class="column"
      data-occupied="true"
      data-testid="podium-column"
      style="--position-index: 1;"
    >
      <div
        class="spacer"
      />
      <div
        class="nickname"
      >
        <div
          class="surface interactive main subtle"
        >
          Radar
        </div>
      </div>
      <div
        class="stackContainer"
      >
        <div
          class="stack"
        >
          <div
            class="position position-2"
          >
            2
          </div>
          <div
            class="surface score sizeSmall transparent"
            data-testid="score-chip"
          >
            <h3
              class="typography title3 alignCenter widthFull colorDefault"
            >
              18398
            </h3>
          </div>
        </div>
      </div>
    </div>
    <div
      class="column"
      data-occupied="true"
      data-testid="podium-column"
      style="--position-index: 2;"
    >
      <div
        class="nickname"
      >
        <div
          class="surface interactive main subtle"
        >
          ShadowCyborg
        </div>
        <div
          aria-hidden="true"
          class="crown"
        >
          👑
        </div>
      </div>
      <div
        class="stackContainer"
      >
        <div
          class="stack"
        >
          <div
            class="position position-1"
          >
            1
          </div>
          <div
            class="surface score sizeSmall transparent"
            data-testid="score-chip"
          >
            <h3
              class="typography title3 alignCenter widthFull colorDefault"
            >
              18456
            </h3>
          </div>
          <div
            aria-hidden="true"
            class="sparkleContainer"
          >
            <div
              class="sparkle"
              style="--sparkle-delay: 0s; --sparkle-x: 50%; --sparkle-y: 50%;"
            />
            <div
              class="sparkle"
              style="--sparkle-delay: 0s; --sparkle-x: 15%; --sparkle-y: 15%;"
            />
