exports[`GameJoinPage > submits when the form is submitted (Enter key equivalent) 1`] = `
<div>
  <div
    class="main"
  >
    <div
      class="header"
    >
      <button
        class="logo"
      >
        <img
          alt="Klurigo"
          class="icon"
          src="/src/assets/images/klurigo-icon.svg"
        />
        <span
          class="text"
        >
          Klurigo
        </span>
      </button>
      <div
        class="side"
      >
        <div
          class="buttonContainer variantPrimary surfaceBrand intentAccent sizeSmall"
        >
          <button
            data-testid="test-back-button-button"
            id="back-button"
            name="back-button"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="svg-inline--fa fa-arrow-left icon"
              data-icon="arrow-left"
              data-prefix="fas"
              role="img"
              viewBox="0 0 512 512"
