exports[`GameJoinPage > renders title and message (via RotatingMessage) 1`] = `
<div>
  <div
    class="main"
  >
    <div
      class="header"
    >
      <button
        class="logo"
      >
        <img
          alt="Klurigo"
          class="icon"
          src="/src/assets/images/klurigo-icon.svg"
        />
        <span
          class="text"
        >
          Klurigo
        </span>
      </button>
      <div
        class="side"
      >
        <div
          class="buttonContainer variantPrimary surfaceBrand intentAccent sizeSmall"
        >
          <button
            data-testid="test-back-button-button"
            id="back-button"
            name="back-button"
            type="button"
          >
            <svg
              aria-hidden="true"
              class="svg-inline--fa fa-arrow-left icon"
              data-icon="arrow-left"
              data-prefix="fas"
              role="img"
              viewBox="0 0 512 512"
            >
              <path
                d="M9.4 233.4c-12.5 12.5-12.5 32.8 0 45.3l160 160c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L109.3 288 480 288c17.7 0 32-14.3 32-32s-14.3-32-32-32l-370.7 0 105.4-105.4c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0l-160 160z"
                fill="currentColor"
              />
            </svg>
            <span>
              Back
            </span>
          </button>
        </div>
      </div>
    </div>
    <main
      class="content contained centerAlign"
    >
      <div
        class="contentWrapper"
      >
        <div
          class="contentInner"
        >
          <div
            class="messageContainer"
          >
            <div
              class="message visible"
            >
              <h1
                class="typography title alignCenter widthMedium colorInverse"
              >
                Join the game
              </h1>
            </div>
          </div>
          <div
            class="messageContainer"
          >
            <div
              class="message visible"
            >
              <p
                class="typography body alignCenter widthSmall colorInverse"
              >
                Pick a nickname and jump in!
              </p>
            </div>
          </div>
          <form
            aria-label="Join game"
            class="stack vertical spacing-stack align-stretch justify-start width-content"
            data-testid="join-form"
            name="join-game-form"
          >
            <div
              class="stack vertical spacing-compact align-center justify-start"
            >
              <h3
                class="typography title3 alignCenter widthFull colorInverse"
              >
                Your game avatar
              </h3>
