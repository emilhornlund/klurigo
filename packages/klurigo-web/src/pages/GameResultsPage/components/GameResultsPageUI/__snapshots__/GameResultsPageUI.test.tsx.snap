              <div
                class="segmentedControlItem segmentedControlInputKindPrimary segmentedControlInputSizeNormal segmentedControlInputInactive"
              >
                <button
                  data-testid="test-section-segmented-control_PLAYERS-segmented-control"
                  id="section-segmented-control_PLAYERS"
                  name="section-segmented-control_PLAYERS"
                  type="button"
                >
                  Players
