                          >
                            1
                          </div>
                          <div
                            class="score"
                          >
                            -40
                          </div>
                          <div
                            class="sparkleContainer"
                          >
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0s; --sparkle-x: 50%; --sparkle-y: 50%;"
                            />
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0s; --sparkle-x: 50%; --sparkle-y: 25%;"
                            />
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0.2s; --sparkle-x: 50%; --sparkle-y: 25%;"
                            />
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0.4s; --sparkle-x: 50%; --sparkle-y: 25%;"
                            />
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0.6000000000000001s; --sparkle-x: 50%; --sparkle-y: 25%;"
                            />
                            <div
                              class="sparkle"
                              style="--sparkle-delay: 0.8s; --sparkle-x: 50%; --sparkle-y: 25%;"
                            />
                            <div
