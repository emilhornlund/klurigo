exports[`GameResultsPageUI > should render GameResultsPageUI for zero to one hundred game mode 1`] = `
<div>
  <div
    class="main"
  >
    <div
      class="header"
    >
      <button
        class="logo"
      >
        <img
          alt="Klurigo"
          class="icon"
          src="/src/assets/images/klurigo-icon.svg"
        />
        <span
          class="text"
        >
          Klurigo
        </span>
      </button>
      <div
        class="side"
      >
        <a
          data-discover="true"
          href="/auth/login"
        >
          Login
        </a>
      </div>
    </div>
    <div
      class="content startAlign"
    >
      <div
        class="contentWrapper fullWidth"
      >
        <div
          class="contentInner"
        >
          <div
            class="gameResultsPage"
          >
            <h1
              class="typography title full"
            >
              0-100 Quiz Debug
            </h1>
            <p
              class="typography text full"
            >
              A quick look at how this game unfolded — see how players performed, how fast they answered, and who stood out.
            </p>
            <div
              class="segmentedControl"
            >
              <div
                class="segmentedControlItem segmentedControlInputKindPrimary segmentedControlInputSizeNormal segmentedControlInputActive"
              >
                <button
                  data-testid="test-section-segmented-control_SUMMARY-segmented-control"
                  id="section-segmented-control_SUMMARY"
                  name="section-segmented-control_SUMMARY"
                  type="button"
                >
                  Summary
