            <button
              aria-label="move-down-0"
              type="button"
            >
              ↓
            </button>
            <button
              aria-label="move-up-0"
              type="button"
            >
              ↑
            </button>
          </li>
          <li
            data-id="B_1"
            data-value="B"
          >
            <span>
              B
            </span>
            <button
              aria-label="move-down-1"
              type="button"
