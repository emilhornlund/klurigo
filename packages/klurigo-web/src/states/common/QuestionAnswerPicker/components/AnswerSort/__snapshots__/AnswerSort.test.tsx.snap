exports[`AnswerSort > disables interaction and hides submit button in non-interactive mode 1`] = `
<div>
  <div
    class="answerSort"
  >
    <div
      class="table"
    >
      <div
        data-disabled="true"
        data-testid="sortable"
      >
        <ul>
          <li
            data-id="A_0"
            data-value="A"
          >
            <span>
              A
