{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    /* Targets */
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],

    /* JSX / React */
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "types": ["vite/client"],

    /* Tooling / Build info */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo"
  },
  "include": ["src"]
}
