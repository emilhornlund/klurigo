events {
    worker_connections  1024;
}

http {
  server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    root /usr/share/nginx/html;

    sendfile on;

    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy "strict-origin" always;
    add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;

    # Quiz media URLs are user supplied, so images and media must support HTTPS
    # origins. Application scripts remain same-origin, while player scripts are
    # limited to the providers supported by ReactPlayer.
    # React components use runtime style attributes for responsive media and
    # gameplay state, which requires the narrowly scoped unsafe-inline exception.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;

    gzip on;
    gzip_http_version 1.1;
    gzip_disable      "MSIE [1-6]\.";
    gzip_min_length   256;
    gzip_vary         on;
    gzip_proxied      any;
    gzip_types        text/plain text/css application/json application/javascript application/x-javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_comp_level   4;

    location / {
      index index.html index.htm;
      expires 60;
      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy "strict-origin" always;
      add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
      add_header Pragma public;
      add_header Cache-Control "public, no-cache";
      try_files $uri $uri/ /index.html?$args;
    }

    location /tunnel {
      proxy_http_version 1.1;
      proxy_ssl_server_name on;
      proxy_set_header Host o4509486568374272.ingest.de.sentry.io;
      proxy_set_header Connection "";
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header Content-Type application/x-sentry-envelope;

      proxy_request_buffering off;
      proxy_buffering off;
      client_max_body_size 10m;
      proxy_read_timeout 30s;

      proxy_pass https://o4509486568374272.ingest.de.sentry.io/api/4509667094298704/envelope/;
    }

    location ~ ^/klurigo-service/api(?<events_path>/games/[^/]+/events)$ {
      proxy_http_version 1.1;
      proxy_set_header Connection "";

      proxy_buffering off;
      proxy_cache off;
      proxy_request_buffering off;

      proxy_read_timeout 1h;
      proxy_send_timeout 1h;

      gzip off;

      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy "strict-origin" always;
      add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
      add_header Cache-Control "no-cache";
      add_header X-Accel-Buffering no;

      # Build the full upstream URL using the existing env var:
      # KLURIGO_SERVICE_PROXY = http://klurigo-service:8080/api
      # events_path          = /games/<id>/events
      set $sse_target ${KLURIGO_SERVICE_PROXY}$events_path$is_args$args;
      proxy_pass $sse_target;
    }

    location /klurigo-service/api/ {
      proxy_pass ${KLURIGO_SERVICE_PROXY}/;

      # Bigger body + stream directly (no temp file buffering)
      client_max_body_size 20m;
      proxy_request_buffering off;
      proxy_buffering off;

      # Helpful for slower uploads
      proxy_http_version 1.1;
      proxy_read_timeout 30s;
      proxy_send_timeout 30s;

      # Preserve Origin and other headers
      proxy_set_header Origin $http_origin;
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy "strict-origin" always;
      add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;

      # Allow preflight caching
      add_header Access-Control-Allow-Origin $http_origin always;
      add_header Access-Control-Allow-Credentials true always;
      add_header Access-Control-Allow-Methods 'GET, POST, PUT, PATCH, DELETE, OPTIONS' always;
      add_header Access-Control-Allow-Headers 'Authorization, Content-Type, Accept, Origin, X-Requested-With' always;

      # Handle OPTIONS (preflight) requests quickly
      if ($request_method = OPTIONS) {
        add_header X-Frame-Options "DENY" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy "strict-origin" always;
        add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
        add_header Content-Length 0;
        add_header Content-Type text/plain;
        return 204;
      }
    }

    location /uploads/images/ {
      proxy_pass ${KLURIGO_SERVICE_IMAGES_PROXY}/;
      add_header X-Frame-Options "DENY" always;
      add_header X-Content-Type-Options nosniff always;
      add_header Referrer-Policy "strict-origin" always;
      add_header Permissions-Policy "geolocation=(),midi=(),sync-xhr=(),microphone=(),camera=(),magnetometer=(),gyroscope=(),fullscreen=(self),payment=()" always;
      add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://www.youtube.com https://fast.wistia.com https://open.spotify.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' https:; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://fast.wistia.net https://open.spotify.com https://player.twitch.tv https://www.tiktok.com; connect-src 'self' https://*.sentry.io https://*.youtube.com https://*.youtube-nocookie.com https://*.vimeo.com https://*.wistia.com https://*.spotify.com https://*.twitch.tv https://*.tiktok.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none';" always;
      add_header Access-Control-Allow-Origin *;
    }
  }
}
