{
  "name": "@klurigo/klurigo-web",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "yarn workspace @klurigo/common build",
    "build": "yarn clean && tsc -b && vite build",
    "dev": "vite",
    "serve": "vite preview",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test": "vitest run",
    "pretest:e2e": "yarn playwright install chromium firefox webkit",
    "test:e2e": "yarn playwright test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:update": "vitest --update",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "check-types": "tsc -p tsconfig.app.json --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@floating-ui/react": "^0.27.20",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@klurigo/common": "1.0.0",
    "@sentry/react": "^10.69.0",
    "@tanstack/react-query": "5.101.4",
    "date-fns": "^4.4.0",
    "event-source-polyfill": "^1.0.31",
    "jwt-decode": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dropzone": "^19.3.0",
    "react-full-screen": "^1.1.1",
    "react-player": "^3.4.0",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.2",
    "react-toastify": "^11.1.0",
    "usehooks-ts": "^3.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@juggle/resize-observer": "^3.4.0",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.7",
    "@storybook/addon-links": "^10.5.7",
    "@storybook/addon-onboarding": "^10.5.7",
    "@storybook/builder-vite": "^10.5.7",
    "@storybook/react": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/event-source-polyfill": "^1.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prop-types": "^15.8.1",
    "sass": "^1.102.0",
    "storybook": "^10.5.7",
