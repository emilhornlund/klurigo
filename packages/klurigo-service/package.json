{
  "name": "@klurigo/klurigo-service",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "prebuild": "yarn workspace @klurigo/common build",
    "build": "yarn clean && nest build",
    "dev": "nest start --watch",
    "dev:e2e": "NODE_ENV=test yarn dev",
    "serve": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test": "jest",
    "test:coverage": "yarn test --coverage",
    "check-circular-deps": "yarn madge --circular src/main.ts",
    "e2e:setup": "tsx scripts/e2e/setup.ts",
    "e2e:teardown": "tsx scripts/e2e/teardown.ts",
    "check-types": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@keyv/redis": "^5.1.6",
    "@klurigo/common": "1.0.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs-modules/ioredis": "^2.2.1",
    "@nestjs-modules/mailer": "^2.3.6",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.24",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@sentry/nestjs": "^10.54.0",
    "@supercharge/request-ip": "^1.2.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.77.4",
    "cache-manager": "^7.2.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.0",
    "joi": "^18.1.2",
    "mongoose": "^9.6.2",
    "ms": "^2.1.3",
    "murlock": "^4.4.0",
    "nodemailer": "^8.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.34.5",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.24",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/nodemailer": "^8.0.0",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^7.2.0",
    "jest": "^30.4.2",
    "jest-extended": "^7.0.0",
    "madge": "^8.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
