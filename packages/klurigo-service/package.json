{
  "name": "@klurigo/klurigo-service",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "clean": "rimraf dist node_modules/.tmp tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "build": "yarn workspace @klurigo/common build && yarn build:app",
    "build:app": "yarn clean && nest build",
    "dev": "nest start --watch",
    "dev:e2e": "NODE_ENV=test yarn dev",
    "serve": "node dist/main",
    "lint": "eslint .",
    "lint:fix": "yarn lint --fix",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "jest --config jest.unit.config.cjs",
    "test:unit:coverage": "jest --config jest.unit.config.cjs --coverage",
    "test:e2e": "jest --config jest.e2e.config.cjs",
    "test:e2e:coverage": "jest --config jest.e2e.config.cjs --coverage",
    "check-circular-deps": "yarn madge --circular src/main.ts",
    "e2e:setup": "tsx scripts/e2e/setup.ts",
    "e2e:teardown": "tsx scripts/e2e/teardown.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.spec.json --noEmit"
  },
  "dependencies": {
    "@keyv/redis": "^6.1.0",
    "@klurigo/common": "1.0.0",
    "@nestjs-modules/ioredis": "^2.3.1",
    "@nestjs-modules/mailer": "^3.0.2",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/serve-static": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@sentry/nestjs": "^11.4.0",
    "@supercharge/request-ip": "^1.2.0",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.11",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "joi": "^18.2.9",
    "keyv": "^6.1.0",
    "mongoose": "^9.10.4",
    "ms": "^2.1.3",
    "multer": "2.4.0",
    "murlock": "^5.1.0",
    "nodemailer": "^10.0.14",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@klurigo/e2e-fixtures": "1.0.0",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/superagent": "^8.1.11",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.4",
    "express": "5.2.1",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "jsonwebtoken": "9.0.3",
    "madge": "^8.0.0",
    "rimraf": "^6.1.3",
    "superagent": "^10.4.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
