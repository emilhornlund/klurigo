{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /* Targets */
    "target": "ES2022",
    "lib": ["ES2022"],

    /* Modules & Resolution */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    /* Emit */
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    /* Strictness & checks */
    "ignoreDeprecations": "6.0",
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,

    /* Tooling / Build info */
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tsbuildinfo"
  }
}
